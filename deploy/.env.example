# Copy to .env and run "chmod 600 .env". Wrap a value in single quotes if it
# contains "$" (Compose does not expand inside single quotes).

# Version of the images to run: a published tag without the leading "v"
# (for example 0.1.0).
ASTOVIA_VERSION=
# Domain that points to this server, host name only (no https://, port or
# path). Caddy obtains the HTTPS certificate for it.
ASTOVIA_DOMAIN=
# Generate once with: openssl rand -base64 32  (keep it; changing it makes the
# stored integration tokens (GitHub, Slack, Chatwork, Google), AI credentials,
# Slack notification webhooks and Web Push keys unreadable)
ASTOVIA_JWT_SECRET=
# Optional: sign in with a Cloudflare Access SaaS application (OIDC) instead
# of passwords. Set all three or none. The team domain is
# https://<team>.cloudflareaccess.com; the redirect URL of the application is
# https://<ASTOVIA_DOMAIN>/auth/access/callback.
ASTOVIA_ACCESS_TEAM_DOMAIN=
ASTOVIA_ACCESS_CLIENT_ID=
ASTOVIA_ACCESS_CLIENT_SECRET=
# Optional: the mail integration (Gmail / Google Workspace). Create a "Web
# application" OAuth client in Google Cloud whose authorized redirect URI is
# https://<ASTOVIA_DOMAIN>/integrations/google/callback. Set both or none.
ASTOVIA_GOOGLE_CLIENT_ID=
ASTOVIA_GOOGLE_CLIENT_SECRET=
# Optional: send notifications by mail as well. ASTOVIA_MAIL_PROVIDER is
# cloudflare (Cloudflare Email Service) or resend (Resend). With it empty, the
# other ASTOVIA_MAIL_* values and ASTOVIA_CLOUDFLARE_ACCOUNT_ID must be empty
# too. ASTOVIA_MAIL_FROM is a bare address (notify@example.com).
# ASTOVIA_MAIL_FROM_NAME is used by Resend only. ASTOVIA_CLOUDFLARE_ACCOUNT_ID
# is required for cloudflare and must be empty for resend.
ASTOVIA_MAIL_PROVIDER=
ASTOVIA_MAIL_API_KEY=
ASTOVIA_MAIL_FROM=
ASTOVIA_MAIL_FROM_NAME=
ASTOVIA_CLOUDFLARE_ACCOUNT_ID=
# Optional: true lets an OpenAI-compatible AI endpoint use http and private
# addresses (read "OpenAI互換の接続先" in the README first). Empty means false.
ASTOVIA_AI_ALLOW_PRIVATE_ENDPOINTS=
