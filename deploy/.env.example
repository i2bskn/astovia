# Copy to .env and run "chmod 600 .env". Wrap a value in single quotes if it
# contains "$" (Compose does not expand inside single quotes).

# Version of the images to run: a published tag without the leading "v"
# (for example 0.1.0).
ASTOVIA_VERSION=
# Domain that points to this server, host name only (no https://, port or
# path). Caddy obtains the HTTPS certificate for it.
ASTOVIA_DOMAIN=
# Generate once with: openssl rand -base64 32  (keep it; changing it makes the
# stored GitHub token, AI key and Web Push keys unreadable)
ASTOVIA_JWT_SECRET=
# Optional: sign in with a Cloudflare Access SaaS application (OIDC) instead
# of passwords. Set all three or none. The team domain is
# https://<team>.cloudflareaccess.com; the redirect URL of the application is
# https://<ASTOVIA_DOMAIN>/auth/access/callback.
ASTOVIA_ACCESS_TEAM_DOMAIN=
ASTOVIA_ACCESS_CLIENT_ID=
ASTOVIA_ACCESS_CLIENT_SECRET=
