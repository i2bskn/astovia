# Copy to .env and run "chmod 600 .env". Wrap a value in single quotes if it
# contains "$" (Compose does not expand inside single quotes).

# Version of the images to run: a published tag without the leading "v"
# (for example 0.1.0).
ASTOVIA_VERSION=
# Domain that points to this server, host name only (no https://, port or
# path). Caddy obtains the HTTPS certificate for it.
ASTOVIA_DOMAIN=
# Generate once with: openssl rand -base64 32  (keep it; changing it makes the
# stored integration tokens (GitHub, Slack, Chatwork, Google), AI credentials,
# Slack notification webhooks and Web Push keys unreadable)
ASTOVIA_JWT_SECRET=
# Optional: sign in with an OpenID Connect provider (Google, Cloudflare Access
# for SaaS, Keycloak, ...) instead of passwords. ASTOVIA_AUTH_MODE is password
# (the default when empty) or oidc. With oidc, ASTOVIA_OIDC_ISSUER,
# ASTOVIA_OIDC_CLIENT_ID and ASTOVIA_OIDC_CLIENT_SECRET are required; without
# it they must be empty.
# - Register the redirect URL https://<ASTOVIA_DOMAIN>/auth/oidc/callback at
#   the provider. Astovia asks for the scopes "openid email".
# - ASTOVIA_OIDC_ISSUER is the issuer of the provider, exactly as it appears
#   in its /.well-known/openid-configuration (for Google,
#   https://accounts.google.com).
# - ASTOVIA_ALLOWED_EMAILS is a comma-separated list of addresses
#   (alice@example.com) and domains (example.com, without subdomains) that
#   can sign in. When it is empty nobody can sign in. "*" allows everyone:
#   use it only when the provider itself limits who can sign in (a Cloudflare
#   Access policy, an "Internal" Google Workspace app). With an "External"
#   Google app, "*" lets any Google account become a member on its first
#   sign-in. With Google, a domain entry also lets in personal Google
#   accounts made with a company address; prefer listing the addresses or an
#   "Internal" Workspace app.
# - ASTOVIA_OIDC_REQUIRE_EMAIL_VERIFIED is true (the default when empty) or
#   false. false accepts ID tokens without the email_verified claim.
# - Cloudflare Access for SaaS: the issuer is
#   https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client ID>,
#   and ASTOVIA_OIDC_REQUIRE_EMAIL_VERIFIED=false is needed because its ID
#   tokens have no email_verified claim. Use it only when every login method
#   of Access is a provider that verifies the email address.
ASTOVIA_AUTH_MODE=
ASTOVIA_OIDC_ISSUER=
ASTOVIA_OIDC_CLIENT_ID=
ASTOVIA_OIDC_CLIENT_SECRET=
ASTOVIA_ALLOWED_EMAILS=
ASTOVIA_OIDC_REQUIRE_EMAIL_VERIFIED=
# Optional: the mail integration (Gmail / Google Workspace). Create a "Web
# application" OAuth client in Google Cloud whose authorized redirect URI is
# https://<ASTOVIA_DOMAIN>/integrations/google/callback. Set both or none.
ASTOVIA_GOOGLE_CLIENT_ID=
ASTOVIA_GOOGLE_CLIENT_SECRET=
# Optional: send notifications by mail as well. ASTOVIA_MAIL_PROVIDER is
# cloudflare (Cloudflare Email Service) or resend (Resend). With it empty, the
# other ASTOVIA_MAIL_* values and ASTOVIA_CLOUDFLARE_ACCOUNT_ID must be empty
# too. ASTOVIA_MAIL_FROM is a bare address (notify@example.com).
# ASTOVIA_MAIL_FROM_NAME is used by Resend only. ASTOVIA_CLOUDFLARE_ACCOUNT_ID
# is required for cloudflare and must be empty for resend.
ASTOVIA_MAIL_PROVIDER=
ASTOVIA_MAIL_API_KEY=
ASTOVIA_MAIL_FROM=
ASTOVIA_MAIL_FROM_NAME=
ASTOVIA_CLOUDFLARE_ACCOUNT_ID=
# Optional: true lets an OpenAI-compatible AI endpoint use http and private
# addresses (read "OpenAI互換の接続先" in https://astovia.dev/guides/ai/ first). Empty means false.
ASTOVIA_AI_ALLOW_PRIVATE_ENDPOINTS=
