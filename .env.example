# アプリを直接起動する場合は、以下の値をシェルでexportしてください。
# アプリ自体には.envの自動読み込み機能がありません。
ASTOVIA_ADDR=127.0.0.1:8080
ASTOVIA_PUBLIC_URL=http://localhost:8080
ASTOVIA_DB_DRIVER=sqlite
ASTOVIA_DB_DSN=file:./data/astovia.db

# serveでのみ必須です。openssl rand -base64 32で一度生成し、安全に保存します。
# 再起動時も同じ値を使用し、Gitへ追加しないでください。
ASTOVIA_JWT_SECRET=

# compose.yamlではDocker Composeが.envまたはシェルの値を展開します。
# 展開対象はASTOVIA_JWT_SECRET、LOCAL_UID、LOCAL_GIDです。
# その他のASTOVIA_*設定はcompose.yaml内のローカル開発用の固定値を使用します。
# Composeのブラウザ入口はhttp://localhost:5173です。直接起動時の既定値は上記8080です。
# UID/GIDはホストのid -u / id -gに合わせてください。未指定時は1000:1000です。
LOCAL_UID=1000
LOCAL_GID=1000
